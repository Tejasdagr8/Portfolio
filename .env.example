# Groq API key for Ask Tejas chat (https://console.groq.com)
GROQ_API_KEY=

# Password for /views analytics dashboard (set a strong value in Vercel / local .env.local)
VIEWS_PASSWORD=change-me

# GitHub personal access token (classic: read:user, or fine-grained: Contents read on nothing +
# account Contributions). Used by /api/github-pulse so contribution totals include private
# activity on @TejasMelkote. Without it, the pulse falls back to public calendars only.
GITHUB_TOKEN=
